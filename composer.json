{
    "name": "cms-orbit/blog",
    "version": "4.0.7",
    "description": "CMS Orbit blog SaaS container package. 유료 패키지 cms-orbit/saas (사설 저장소 배포)가 필요합니다.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "cms-orbit/core": "^4.1",
        "cms-orbit/saas": "^4.0.8",
        "laravel/framework": "^11.0 || ^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "CmsOrbit\\Blog\\": "src/"
        },
        "classmap": [
            "container/themes/"
        ],
        "files": [
            "src/Support/helpers.php"
        ]
    },
    "extra": {
        "orbit": {
            "container": "container"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "laravel/pint": "^1.30"
    },
    "scripts": {
        "post-install-cmd": [
            "git config core.hooksPath .githooks || true"
        ]
    }
}
